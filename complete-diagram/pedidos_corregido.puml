@startuml pedidos_corregido
hide empty members

class Cliente {
    -id: int
    -nombre: String
    -correo: String
    +registrarPedido(): Pedido
}

class Pedido {
    -id: int
    -fecha: LocalDate
    -estado: String
    +agregarDetalle(producto: Producto, cantidad: int): void
    +calcularTotal(): double
    +confirmar(servicio: ServicioPago): boolean
}

class DetallePedido {
    -cantidad: int
    -precioAplicado: double
    +calcularSubtotal(): double
}

abstract class Producto {
    -id: int
    -nombre: String
    -precio: double
    +obtenerPrecio(): double
    {abstract} +calcularCostoEntrega(): double
}

class ProductoFisico {
    -peso: double
    -costoBaseEnvio: double
    +calcularCostoEntrega(): double
}

class ProductoDigital {
    -urlDescarga: String
    +calcularCostoEntrega(): double
}

class Catalogo {
    -id: int
    -nombre: String
    +agregarProducto(producto: Producto): void
    +buscarProducto(id: int): Producto
}

interface ServicioPago {
    +procesarPago(monto: double): boolean
}

' ASOCIACION unidireccional: Cliente conoce sus pedidos (extremo -pedidos)
Cliente "1" --> "-pedidos 0..*" Pedido : registra

' COMPOSICION: el detalle no existe sin su pedido (extremo -detalles)
Pedido "1" *--> "-detalles 1..*" DetallePedido : contiene

' ASOCIACION unidireccional: el detalle conoce su producto (extremo -producto)
DetallePedido "0..*" --> "-producto 1" Producto : referencia

' AGREGACION: los productos existen sin catalogo (extremo -productos)
Catalogo "0..*" o--> "-productos 0..*" Producto : organiza

' GENERALIZACION (es un)
Producto <|-- ProductoFisico
Producto <|-- ProductoDigital

' DEPENDENCIA: ServicioPago solo es parametro de Pedido.confirmar
Pedido ..> ServicioPago : <<use>>
@enduml
